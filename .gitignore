# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
*.tsbuildinfo

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/coverage
npm-debug.log
yarn-error.log

# System Files
.DS_Store
Thumbs.db

# Local caches and tool state
.cache/
.claude/

# Local environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Private keys and credential bundles
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore

# Local credential and secret files
credentials
credentials.*
secrets
secrets.*
.secrets
.secrets.*
.local-secrets/
